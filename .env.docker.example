# ─────────────────────────────────────────────────────────────────────────────
# Emran Uang API — Docker Environment Variables Example
# Salin file ini menjadi .env di server VPS Anda:
#   cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. PILIHAN DATABASE (PILIH SALAH SATU) ───────────────────────────────────

# OPSI A: Menggunakan PostgreSQL lokal di Docker (Service 'postgres' pada docker-compose)
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@postgres:5432/emran_uang?schema=public"
DIRECT_URL="postgresql://postgres:postgres_secure_password@postgres:5432/emran_uang?schema=public"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="emran_uang"
POSTGRES_PORT=5432

# OPSI B: Menggunakan Cloud PostgreSQL (contoh: Neon Serverless)
# Jika menggunakan Opsi B, beri komentar pada Opsi A di atas dan isi URL Neon Anda:
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech:5432/emran_uang?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech:5432/emran_uang?sslmode=require"

# ── 2. DATABASE MIGRATION & SEEDING OTOMATIS ─────────────────────────────────
# Jalankan prisma db push otomatis saat kontainer API menyala (sangat disarankan saat deploy pertama)
RUN_DB_PUSH=true
# Jalankan seed dummy data (opsional, set true jika ingin data awal kategori & dummy data)
RUN_DB_SEED=false

# ── 3. KEAMANAN & JWT (WAJIB GANTI DENGAN STRING RANDOM KUAT) ────────────────
# Tip: Generate random secret di terminal VPS dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-string-rahasia-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="ganti-dengan-refresh-secret-acak-minimal-32-karakter"
JWT_REFRESH_EXPIRES_IN="30d"

# ── 4. GOOGLE OAUTH ──────────────────────────────────────────────────────────
# Dapatkan dari Google Cloud Console Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── 5. APLIKASI & NETWORK ────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"

# CORS: Masukkan domain / origin yang diizinkan (pisahkan dengan koma).
# Contoh: "https://api.domainanda.com,https://app.domainanda.com" atau "*"
ALLOWED_ORIGINS="*"

# ── 6. CRON SECRET UNTUK PENGINGAT TAGIHAN ───────────────────────────────────
# Endpoint: POST /api/notifications/cron/bill-reminders
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="ganti-dengan-cron-secret-acak-anda"

# ── 7. FIREBASE CLOUD MESSAGING (PUSH NOTIFIKASI) ────────────────────────────
# Anda bisa menaruh isi JSON file firebase service account sebagai string 1 baris di sini:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# ── 8. AI VISION UNTUK OCR SCAN STRUK TRANSAKSI ─────────────────────────────
# Opsi [openrouter, openai, gemini]
AI_PROVIDER="openrouter"
# Opsi 1: Google Gemini API (Gratis di AI Studio)
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-3.6-flash"

# Jika lokasi IP server VPS Anda diblokir Google ("User location is not supported"):
# Solusi A: Gunakan Cloudflare Worker Reverse Proxy (Gratis & Mudah)
# GEMINI_BASE_URL="https://gemini-proxy.yourname.workers.dev"

# Solusi B: Gunakan OpenRouter API (Tersedia Gemini Flash tanpa blokir region/lokasi)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="google/gemini-2.5-flash"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Solusi C: Gunakan OpenAI API (GPT-4o-mini vision)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
